# Образец переменных. Настоящие значения — только в Vercel → Settings → Environment Variables.
# Этот файл без секретов, его можно хранить в GitHub.

# Публичные (видны в браузере, это нормально)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_YANDEX_MAPS_API_KEY=

# Секретные (только на сервере, никогда не начинаются с NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_API_SECRET=
YANDEX_GEOCODER_KEY=
FOURSQUARE_API_KEY=
